# Local development only. Do not add provider credentials to this file.
ALON_AI_DATABASE_URL=postgresql+psycopg://alon_ai:alon_ai@localhost:5432/alon_ai
ALON_AI_DBOS_SYSTEM_DATABASE_URL=postgresql://alon_ai:alon_ai@localhost:5432/alon_ai
ALON_AI_FRONTEND_ORIGIN=http://localhost:3000
ALON_AI_ENVIRONMENT=development
ALON_AI_LOG_LEVEL=INFO
ALON_AI_OUTREACH_ENABLED=false
ALON_AI_PROVIDER_MODE=disabled
ALON_AI_GENERATIVE_AI_PROVIDER=openai
# Production: explicit non-example database URLs, HTTPS frontend origin,
# and opaque provider/OAuth secret handles are required. Keys stay outside backups.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
