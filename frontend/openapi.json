{
  "components": {
    "schemas": {
      "AcceptRequest": {
        "additionalProperties": false,
        "properties": {
          "command_key": {
            "format": "uuid",
            "title": "Command Key",
            "type": "string"
          },
          "intent_confirmed": {
            "title": "Intent Confirmed",
            "type": "boolean"
          },
          "intent_rationale": {
            "maxLength": 4000,
            "minLength": 1,
            "title": "Intent Rationale",
            "type": "string"
          },
          "intent_relationship": {
            "enum": [
              "PRESERVES_CORE_INTENT",
              "CLARIFIES_CORE_INTENT",
              "NARROWS_CORE_INTENT",
              "MATERIAL_PIVOT",
              "UNRELATED"
            ],
            "title": "Intent Relationship",
            "type": "string"
          },
          "run_id": {
            "format": "uuid",
            "title": "Run Id",
            "type": "string"
          }
        },
        "required": [
          "run_id",
          "command_key",
          "intent_relationship",
          "intent_confirmed",
          "intent_rationale"
        ],
        "title": "AcceptRequest",
        "type": "object"
      },
      "ActivityItem": {
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "title": "Kind",
            "type": "string"
          },
          "label": {
            "title": "Label",
            "type": "string"
          },
          "occurred_at": {
            "format": "date-time",
            "title": "Occurred At",
            "type": "string"
          },
          "state": {
            "enum": [
              "queued",
              "running",
              "completed",
              "blocked"
            ],
            "title": "State",
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "state",
          "label",
          "occurred_at"
        ],
        "title": "ActivityItem",
        "type": "object"
      },
      "ActivityResponse": {
        "properties": {
          "cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cursor"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/ActivityItem"
            },
            "title": "Items",
            "type": "array"
          }
        },
        "required": [
          "items",
          "cursor"
        ],
        "title": "ActivityResponse",
        "type": "object"
      },
      "CommercialInput": {
        "additionalProperties": false,
        "properties": {
          "currency": {
            "pattern": "^[A-Z]{3}$",
            "title": "Currency",
            "type": "string"
          },
          "hourly_cost": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d{0,6}0*$",
                "type": "string"
              }
            ],
            "title": "Hourly Cost"
          },
          "maximum_discount_rate": {
            "anyOf": [
              {
                "maximum": 1.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d{0,6}0*$",
                "type": "string"
              }
            ],
            "title": "Maximum Discount Rate"
          },
          "minimum_deposit_rate": {
            "anyOf": [
              {
                "maximum": 1.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d{0,6}0*$",
                "type": "string"
              }
            ],
            "title": "Minimum Deposit Rate"
          },
          "minimum_margin_rate": {
            "anyOf": [
              {
                "maximum": 1.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d{0,6}0*$",
                "type": "string"
              }
            ],
            "title": "Minimum Margin Rate"
          },
          "minimum_project_price": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d{0,6}0*$",
                "type": "string"
              }
            ],
            "title": "Minimum Project Price"
          }
        },
        "required": [
          "currency",
          "hourly_cost",
          "minimum_project_price",
          "minimum_margin_rate",
          "maximum_discount_rate",
          "minimum_deposit_rate"
        ],
        "title": "CommercialInput",
        "type": "object"
      },
      "CreateExperimentRequest": {
        "additionalProperties": false,
        "properties": {
          "brief": {
            "$ref": "#/components/schemas/ExperimentBriefInput"
          },
          "command_key": {
            "format": "uuid",
            "title": "Command Key",
            "type": "string"
          },
          "idea_seed": {
            "anyOf": [
              {
                "maxLength": 4000,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Idea Seed"
          },
          "name": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "operator_profile": {
            "$ref": "#/components/schemas/OperatorProfileInput"
          }
        },
        "required": [
          "name",
          "brief",
          "operator_profile",
          "command_key"
        ],
        "title": "CreateExperimentRequest",
        "type": "object"
      },
      "CreateExperimentResponse": {
        "additionalProperties": false,
        "properties": {
          "brief_artifact_id": {
            "format": "uuid",
            "title": "Brief Artifact Id",
            "type": "string"
          },
          "cycle_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cycle Id"
          },
          "experiment_id": {
            "format": "uuid",
            "title": "Experiment Id",
            "type": "string"
          },
          "seed_artifact_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Seed Artifact Id"
          },
          "state": {
            "enum": [
              "AWAITING_REFINEMENT",
              "AWAITING_DISCOVERY"
            ],
            "title": "State",
            "type": "string"
          }
        },
        "required": [
          "experiment_id",
          "cycle_id",
          "brief_artifact_id",
          "seed_artifact_id",
          "state"
        ],
        "title": "CreateExperimentResponse",
        "type": "object"
      },
      "DeliveryInput": {
        "additionalProperties": false,
        "properties": {
          "concurrent_projects": {
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Concurrent Projects",
            "type": "integer"
          },
          "hours_per_week": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "maximum": 168.0,
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d{0,2}0*$",
                "type": "string"
              }
            ],
            "title": "Hours Per Week"
          },
          "max_project_hours": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "maximum": 100000.0,
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d{0,2}0*$",
                "type": "string"
              }
            ],
            "title": "Max Project Hours"
          }
        },
        "required": [
          "max_project_hours",
          "hours_per_week",
          "concurrent_projects"
        ],
        "title": "DeliveryInput",
        "type": "object"
      },
      "ExperimentBriefInput": {
        "additionalProperties": false,
        "properties": {
          "budget_usd": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d{0,2}0*$",
                "type": "string"
              }
            ],
            "title": "Budget Usd"
          },
          "commercial_boundaries": {
            "maxLength": 4000,
            "minLength": 1,
            "title": "Commercial Boundaries",
            "type": "string"
          },
          "evidence_definitions": {
            "items": {
              "type": "string"
            },
            "maxItems": 20,
            "minItems": 1,
            "title": "Evidence Definitions",
            "type": "array"
          },
          "geographies": {
            "items": {
              "type": "string"
            },
            "maxItems": 20,
            "minItems": 1,
            "title": "Geographies",
            "type": "array"
          },
          "launch_stage": {
            "const": "SHADOW",
            "title": "Launch Stage",
            "type": "string"
          },
          "objective": {
            "maxLength": 4000,
            "minLength": 1,
            "title": "Objective",
            "type": "string"
          },
          "problem": {
            "maxLength": 4000,
            "minLength": 1,
            "title": "Problem",
            "type": "string"
          },
          "target_customer": {
            "maxLength": 4000,
            "minLength": 1,
            "title": "Target Customer",
            "type": "string"
          }
        },
        "required": [
          "objective",
          "target_customer",
          "problem",
          "geographies",
          "commercial_boundaries",
          "budget_usd",
          "evidence_definitions",
          "launch_stage"
        ],
        "title": "ExperimentBriefInput",
        "type": "object"
      },
      "ExperimentRuntimeStatus": {
        "additionalProperties": false,
        "properties": {
          "provider_mode": {
            "enum": [
              "disabled",
              "fake",
              "live"
            ],
            "title": "Provider Mode",
            "type": "string"
          },
          "ready": {
            "title": "Ready",
            "type": "boolean"
          }
        },
        "required": [
          "provider_mode",
          "ready"
        ],
        "title": "ExperimentRuntimeStatus",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "LivenessResponse": {
        "properties": {
          "service": {
            "const": "api",
            "title": "Service",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "service"
        ],
        "title": "LivenessResponse",
        "type": "object"
      },
      "LoginRequest": {
        "properties": {
          "password": {
            "maxLength": 1024,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "password"
        ],
        "title": "LoginRequest",
        "type": "object"
      },
      "OperatorProfileInput": {
        "additionalProperties": false,
        "properties": {
          "capabilities": {
            "items": {
              "type": "string"
            },
            "maxItems": 100,
            "minItems": 1,
            "title": "Capabilities",
            "type": "array"
          },
          "commercial": {
            "$ref": "#/components/schemas/CommercialInput"
          },
          "constraints": {
            "items": {
              "type": "string"
            },
            "maxItems": 100,
            "title": "Constraints",
            "type": "array"
          },
          "delivery": {
            "$ref": "#/components/schemas/DeliveryInput"
          }
        },
        "required": [
          "capabilities",
          "constraints",
          "delivery",
          "commercial"
        ],
        "title": "OperatorProfileInput",
        "type": "object"
      },
      "OperatorSession": {
        "properties": {
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "display_name"
        ],
        "title": "OperatorSession",
        "type": "object"
      },
      "ReadinessResponse": {
        "properties": {
          "database": {
            "const": "up",
            "title": "Database",
            "type": "string"
          },
          "status": {
            "const": "ready",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "database"
        ],
        "title": "ReadinessResponse",
        "type": "object"
      },
      "ReadinessUnavailableResponse": {
        "properties": {
          "database": {
            "const": "down",
            "title": "Database",
            "type": "string"
          },
          "status": {
            "const": "not_ready",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "database"
        ],
        "title": "ReadinessUnavailableResponse",
        "type": "object"
      },
      "RefineRequest": {
        "additionalProperties": false,
        "properties": {
          "idempotency_key": {
            "format": "uuid",
            "title": "Idempotency Key",
            "type": "string"
          }
        },
        "required": [
          "idempotency_key"
        ],
        "title": "RefineRequest",
        "type": "object"
      },
      "ReturnFeedbackInput": {
        "additionalProperties": false,
        "properties": {
          "artifact_id": {
            "format": "uuid",
            "title": "Artifact Id",
            "type": "string"
          },
          "content_hash": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Content Hash",
            "type": "string"
          },
          "kind": {
            "const": "RESEARCH_FEEDBACK_BRIEF",
            "title": "Kind",
            "type": "string"
          },
          "role": {
            "const": "RESEARCH_FEEDBACK",
            "title": "Role",
            "type": "string"
          },
          "version": {
            "minimum": 1.0,
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "artifact_id",
          "kind",
          "version",
          "content_hash",
          "role"
        ],
        "title": "ReturnFeedbackInput",
        "type": "object"
      },
      "SelectCandidateRequest": {
        "additionalProperties": false,
        "properties": {
          "candidate_artifact_id": {
            "format": "uuid",
            "title": "Candidate Artifact Id",
            "type": "string"
          },
          "command_key": {
            "format": "uuid",
            "title": "Command Key",
            "type": "string"
          },
          "reason": {
            "maxLength": 4000,
            "minLength": 1,
            "title": "Reason",
            "type": "string"
          }
        },
        "required": [
          "candidate_artifact_id",
          "reason",
          "command_key"
        ],
        "title": "SelectCandidateRequest",
        "type": "object"
      },
      "SessionResponse": {
        "properties": {
          "authenticated": {
            "default": true,
            "title": "Authenticated",
            "type": "boolean"
          },
          "operator": {
            "$ref": "#/components/schemas/OperatorSession"
          }
        },
        "required": [
          "operator"
        ],
        "title": "SessionResponse",
        "type": "object"
      },
      "StartReturnRefinementRequest": {
        "additionalProperties": false,
        "properties": {
          "command_key": {
            "format": "uuid",
            "title": "Command Key",
            "type": "string"
          },
          "feedback": {
            "$ref": "#/components/schemas/ReturnFeedbackInput"
          },
          "verdict_id": {
            "format": "uuid",
            "title": "Verdict Id",
            "type": "string"
          }
        },
        "required": [
          "verdict_id",
          "feedback",
          "command_key"
        ],
        "title": "StartReturnRefinementRequest",
        "type": "object"
      },
      "SystemStatus": {
        "properties": {
          "counts": {
            "additionalProperties": {
              "type": "integer"
            },
            "propertyNames": {
              "enum": [
                "queued",
                "running",
                "completed",
                "blocked"
              ]
            },
            "title": "Counts",
            "type": "object"
          },
          "health": {
            "additionalProperties": {
              "const": "ok",
              "type": "string"
            },
            "title": "Health",
            "type": "object"
          },
          "readiness": {
            "additionalProperties": {
              "enum": [
                "ready",
                "not_ready"
              ],
              "type": "string"
            },
            "title": "Readiness",
            "type": "object"
          }
        },
        "required": [
          "health",
          "readiness",
          "counts"
        ],
        "title": "SystemStatus",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Alon AI API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/auth/login": {
      "post": {
        "operationId": "login_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Login"
      }
    },
    "/auth/logout": {
      "post": {
        "operationId": "logout_auth_logout_post",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        },
        "summary": "Logout"
      }
    },
    "/auth/session": {
      "get": {
        "operationId": "session_auth_session_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Session"
      }
    },
    "/health/live": {
      "get": {
        "operationId": "live_health_live_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LivenessResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Live"
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "ready_health_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessUnavailableResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Ready"
      }
    },
    "/operator/activity": {
      "get": {
        "operationId": "activity_operator_activity_get",
        "parameters": [
          {
            "in": "query",
            "name": "experiment_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "uuid",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Experiment Id"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActivityResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Activity"
      }
    },
    "/operator/activity/events": {
      "get": {
        "operationId": "activity_events_operator_activity_events_get",
        "parameters": [
          {
            "in": "query",
            "name": "experiment_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "uuid",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Experiment Id"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Activity Events"
      }
    },
    "/operator/experiments": {
      "post": {
        "operationId": "create_experiment_operator_experiments_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateExperimentRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateExperimentResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create Experiment"
      }
    },
    "/operator/experiments/runtime": {
      "get": {
        "operationId": "experiment_runtime_status_operator_experiments_runtime_get",
        "responses": {
          "200": {
