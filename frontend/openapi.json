{
  "components": {
    "schemas": {
      "ActivityItem": {
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "title": "Kind",
            "type": "string"
          },
          "label": {
            "title": "Label",
            "type": "string"
          },
          "occurred_at": {
            "format": "date-time",
            "title": "Occurred At",
            "type": "string"
          },
          "state": {
            "enum": [
              "queued",
              "running",
              "completed",
              "blocked"
            ],
            "title": "State",
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "state",
          "label",
          "occurred_at"
        ],
        "title": "ActivityItem",
        "type": "object"
      },
      "ActivityResponse": {
        "properties": {
          "cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cursor"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/ActivityItem"
            },
            "title": "Items",
            "type": "array"
          }
        },
        "required": [
          "items",
          "cursor"
        ],
        "title": "ActivityResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "LivenessResponse": {
        "properties": {
          "service": {
            "const": "api",
            "title": "Service",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "service"
        ],
        "title": "LivenessResponse",
        "type": "object"
      },
      "LoginRequest": {
        "properties": {
          "password": {
            "maxLength": 1024,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "password"
        ],
        "title": "LoginRequest",
        "type": "object"
      },
      "OperatorSession": {
        "properties": {
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "display_name"
        ],
        "title": "OperatorSession",
        "type": "object"
      },
      "ReadinessResponse": {
        "properties": {
          "database": {
            "const": "up",
            "title": "Database",
            "type": "string"
          },
          "status": {
            "const": "ready",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "database"
        ],
        "title": "ReadinessResponse",
        "type": "object"
      },
      "ReadinessUnavailableResponse": {
        "properties": {
          "database": {
            "const": "down",
            "title": "Database",
            "type": "string"
          },
          "status": {
            "const": "not_ready",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "database"
        ],
        "title": "ReadinessUnavailableResponse",
        "type": "object"
      },
      "SessionResponse": {
        "properties": {
          "authenticated": {
            "default": true,
            "title": "Authenticated",
            "type": "boolean"
          },
          "operator": {
            "$ref": "#/components/schemas/OperatorSession"
          }
        },
        "required": [
          "operator"
        ],
        "title": "SessionResponse",
        "type": "object"
      },
      "SystemStatus": {
        "properties": {
          "counts": {
            "additionalProperties": {
              "type": "integer"
            },
            "propertyNames": {
              "enum": [
                "queued",
                "running",
                "completed",
                "blocked"
              ]
            },
            "title": "Counts",
            "type": "object"
          },
          "health": {
            "additionalProperties": {
              "const": "ok",
              "type": "string"
            },
            "title": "Health",
            "type": "object"
          },
          "readiness": {
            "additionalProperties": {
              "enum": [
                "ready",
                "not_ready"
              ],
              "type": "string"
            },
            "title": "Readiness",
            "type": "object"
          }
        },
        "required": [
          "health",
          "readiness",
          "counts"
        ],
        "title": "SystemStatus",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Alon AI API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/auth/login": {
      "post": {
        "operationId": "login_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Login"
      }
    },
    "/auth/logout": {
      "post": {
        "operationId": "logout_auth_logout_post",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        },
        "summary": "Logout"
      }
    },
    "/auth/session": {
      "get": {
        "operationId": "session_auth_session_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Session"
      }
    },
    "/health/live": {
      "get": {
        "operationId": "live_health_live_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LivenessResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Live"
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "ready_health_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessUnavailableResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Ready"
      }
    },
    "/operator/activity": {
      "get": {
        "operationId": "activity_operator_activity_get",
        "parameters": [
          {
            "in": "query",
            "name": "experiment_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "uuid",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Experiment Id"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActivityResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Activity"
      }
    },
    "/operator/activity/events": {
      "get": {
        "operationId": "activity_events_operator_activity_events_get",
        "parameters": [
          {
            "in": "query",
            "name": "experiment_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "uuid",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Experiment Id"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Activity Events"
      }
    },
    "/operator/status": {
      "get": {
        "operationId": "status_operator_status_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SystemStatus"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Status"
      }
    }
  }
}
