{
  "components": {
    "schemas": {
      "AcceptRequest": {
        "additionalProperties": false,
        "properties": {
          "command_key": {
            "format": "uuid",
            "title": "Command Key",
            "type": "string"
          },
          "intent_confirmed": {
            "title": "Intent Confirmed",
            "type": "boolean"
          },
          "intent_rationale": {
            "maxLength": 4000,
            "minLength": 1,
            "title": "Intent Rationale",
            "type": "string"
          },
          "intent_relationship": {
            "enum": [
              "PRESERVES_CORE_INTENT",
              "CLARIFIES_CORE_INTENT",
              "NARROWS_CORE_INTENT",
              "MATERIAL_PIVOT",
              "UNRELATED"
            ],
            "title": "Intent Relationship",
            "type": "string"
          },
          "run_id": {
            "format": "uuid",
            "title": "Run Id",
            "type": "string"
          }
        },
        "required": [
          "run_id",
          "command_key",
          "intent_relationship",
          "intent_confirmed",
          "intent_rationale"
        ],
        "title": "AcceptRequest",
        "type": "object"
      },
      "ActivityItem": {
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "title": "Kind",
            "type": "string"
          },
          "label": {
            "title": "Label",
            "type": "string"
          },
          "occurred_at": {
            "format": "date-time",
            "title": "Occurred At",
            "type": "string"
          },
          "state": {
            "enum": [
              "queued",
              "running",
              "completed",
              "blocked"
            ],
            "title": "State",
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "state",
          "label",
          "occurred_at"
        ],
        "title": "ActivityItem",
        "type": "object"
      },
      "ActivityResponse": {
        "properties": {
          "cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cursor"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/ActivityItem"
            },
            "title": "Items",
            "type": "array"
          }
        },
        "required": [
          "items",
          "cursor"
        ],
        "title": "ActivityResponse",
        "type": "object"
      },
      "CreateExperimentRequest": {
        "additionalProperties": false,
        "properties": {
          "command_key": {
            "format": "uuid",
            "title": "Command Key",
            "type": "string"
          },
          "idea_seed": {
            "anyOf": [
              {
                "maxLength": 4000,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Idea Seed"
          }
        },
        "required": [
          "command_key"
        ],
        "title": "CreateExperimentRequest",
        "type": "object"
      },
      "ExperimentRuntimeStatus": {
        "additionalProperties": false,
        "properties": {
          "provider_mode": {
            "enum": [
              "disabled",
              "fake",
              "live"
            ],
            "title": "Provider Mode",
            "type": "string"
          },
          "ready": {
            "title": "Ready",
            "type": "boolean"
          }
        },
        "required": [
          "provider_mode",
          "ready"
        ],
        "title": "ExperimentRuntimeStatus",
        "type": "object"
      },
      "ExperimentSnapshot": {
        "additionalProperties": true,
        "properties": {
          "accepted_brief": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Accepted Brief"
          },
          "advice": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Advice"
          },
          "advice_source": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Advice Source"
          },
          "blocked_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Blocked Reason"
          },
          "brief": {
            "additionalProperties": true,
            "title": "Brief",
            "type": "object"
          },
          "candidates": {
            "items": {
              "$ref": "#/components/schemas/ProposalSnapshot"
            },
            "title": "Candidates",
            "type": "array"
          },
          "cycle_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cycle Id"
          },
          "draft": {
            "title": "Draft",
            "type": "boolean"
          },
          "experiment_id": {
            "format": "uuid",
            "title": "Experiment Id",
            "type": "string"
          },
          "idea_seed": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Idea Seed"
          },
          "latest_outcome": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latest Outcome"
          },
          "latest_run_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latest Run Id"
          },
          "mode": {
            "enum": [
              "USER_SEEDED_REFINEMENT",
              "SYSTEM_DISCOVERY"
            ],
            "title": "Mode",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "proposal_history": {
            "items": {
              "$ref": "#/components/schemas/ProposalRevisionSnapshot"
            },
            "title": "Proposal History",
            "type": "array"
          },
          "provider_mode": {
            "enum": [
              "disabled",
              "fake",
              "live"
            ],
            "title": "Provider Mode",
            "type": "string"
          },
          "retry_safe": {
            "title": "Retry Safe",
            "type": "boolean"
          },
          "selected_candidate_artifact_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Selected Candidate Artifact Id"
          },
          "stage": {
            "enum": [
              "IDEA_DISCOVERY",
              "IDEA_REFINEMENT"
            ],
            "title": "Stage",
            "type": "string"
          },
          "stage_status": {
            "enum": [
              "RUNNING",
              "WAITING_FOR_INPUT",
              "BLOCKED",
              "COMPLETE"
            ],
            "title": "Stage Status",
            "type": "string"
          },
          "state": {
            "title": "State",
            "type": "string"
          }
        },
        "required": [
          "experiment_id",
          "name",
          "mode",
          "state",
          "brief",
          "idea_seed",
          "cycle_id",
          "latest_run_id",
          "latest_outcome",
          "advice_source",
          "advice",
          "accepted_brief",
          "candidates",
          "selected_candidate_artifact_id",
          "retry_safe",
          "draft",
          "provider_mode",
          "stage",
          "stage_status",
          "blocked_reason",
          "proposal_history"
        ],
        "title": "ExperimentSnapshot",
        "type": "object"
      },
      "GenerateIdeaRequest": {
        "additionalProperties": false,
        "properties": {
          "command_key": {
            "format": "uuid",
            "title": "Command Key",
            "type": "string"
          }
        },
        "required": [
          "command_key"
        ],
        "title": "GenerateIdeaRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "LivenessResponse": {
        "properties": {
          "service": {
            "const": "api",
            "title": "Service",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "service"
        ],
        "title": "LivenessResponse",
        "type": "object"
      },
      "LoginRequest": {
        "properties": {
          "password": {
            "maxLength": 1024,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "password"
        ],
        "title": "LoginRequest",
        "type": "object"
      },
      "OperatorSession": {
        "properties": {
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "display_name"
        ],
        "title": "OperatorSession",
        "type": "object"
      },
      "ProposalRevisionSnapshot": {
        "properties": {
          "artifact_id": {
            "format": "uuid",
            "title": "Artifact Id",
            "type": "string"
          },
          "hypothesis": {
            "title": "Hypothesis",
            "type": "string"
          },
          "idea_seed": {
            "title": "Idea Seed",
            "type": "string"
          },
          "origin": {
            "enum": [
              "GENERATED",
              "OPERATOR_EDIT"
            ],
            "title": "Origin",
            "type": "string"
          },
          "parent_artifact_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Parent Artifact Id"
          },
          "run_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Run Id"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "artifact_id",
          "version",
          "parent_artifact_id",
          "title",
          "hypothesis",
          "idea_seed",
          "origin",
          "run_id"
        ],
        "title": "ProposalRevisionSnapshot",
        "type": "object"
      },
      "ProposalSnapshot": {
        "properties": {
          "artifact_id": {
            "format": "uuid",
            "title": "Artifact Id",
            "type": "string"
          },
          "demand_status": {
            "const": "UNVERIFIED",
            "title": "Demand Status",
            "type": "string"
          },
          "hypothesis": {
            "title": "Hypothesis",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "uncertainties": {
            "items": {
              "type": "string"
            },
            "title": "Uncertainties",
            "type": "array"
          }
        },
        "required": [
          "artifact_id",
          "title",
          "hypothesis",
          "demand_status",
          "uncertainties"
        ],
        "title": "ProposalSnapshot",
        "type": "object"
      },
      "ReadinessResponse": {
        "properties": {
          "database": {
            "const": "up",
            "title": "Database",
            "type": "string"
          },
          "status": {
            "const": "ready",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "database"
        ],
        "title": "ReadinessResponse",
        "type": "object"
      },
      "ReadinessUnavailableResponse": {
        "properties": {
          "database": {
            "const": "down",
            "title": "Database",
            "type": "string"
          },
          "status": {
            "const": "not_ready",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "database"
        ],
        "title": "ReadinessUnavailableResponse",
        "type": "object"
      },
      "RefineRequest": {
        "additionalProperties": false,
        "properties": {
          "idempotency_key": {
            "format": "uuid",
            "title": "Idempotency Key",
            "type": "string"
          }
        },
        "required": [
          "idempotency_key"
        ],
        "title": "RefineRequest",
        "type": "object"
      },
      "RegenerateIdeaRequest": {
        "additionalProperties": false,
        "properties": {
          "candidate_artifact_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Candidate Artifact Id"
          },
          "command_key": {
            "format": "uuid",
            "title": "Command Key",
            "type": "string"
          }
        },
        "required": [
          "command_key"
        ],
        "title": "RegenerateIdeaRequest",
        "type": "object"
      },
      "ReturnFeedbackInput": {
        "additionalProperties": false,
        "properties": {
          "artifact_id": {
            "format": "uuid",
            "title": "Artifact Id",
            "type": "string"
          },
          "content_hash": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Content Hash",
            "type": "string"
          },
          "kind": {
            "const": "RESEARCH_FEEDBACK_BRIEF",
            "title": "Kind",
            "type": "string"
          },
          "role": {
            "const": "RESEARCH_FEEDBACK",
            "title": "Role",
            "type": "string"
          },
          "version": {
            "minimum": 1.0,
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "artifact_id",
          "kind",
          "version",
          "content_hash",
          "role"
        ],
        "title": "ReturnFeedbackInput",
        "type": "object"
      },
      "ReviseProposalRequest": {
        "additionalProperties": false,
        "properties": {
          "candidate_artifact_id": {
            "format": "uuid",
            "title": "Candidate Artifact Id",
            "type": "string"
          },
          "command_key": {
            "format": "uuid",
            "title": "Command Key",
            "type": "string"
          },
          "idea_seed": {
            "maxLength": 4000,
            "minLength": 1,
            "title": "Idea Seed",
            "type": "string"
          }
        },
        "required": [
          "command_key",
          "candidate_artifact_id",
          "idea_seed"
        ],
        "title": "ReviseProposalRequest",
        "type": "object"
      },
      "SelectCandidateRequest": {
        "additionalProperties": false,
        "properties": {
          "candidate_artifact_id": {
            "format": "uuid",
            "title": "Candidate Artifact Id",
            "type": "string"
          },
          "command_key": {
            "format": "uuid",
            "title": "Command Key",
            "type": "string"
          },
          "reason": {
            "maxLength": 4000,
            "minLength": 1,
            "title": "Reason",
            "type": "string"
          }
        },
        "required": [
          "candidate_artifact_id",
          "reason",
          "command_key"
        ],
        "title": "SelectCandidateRequest",
        "type": "object"
      },
      "SessionResponse": {
        "properties": {
          "authenticated": {
            "default": true,
            "title": "Authenticated",
            "type": "boolean"
          },
          "operator": {
            "$ref": "#/components/schemas/OperatorSession"
          }
        },
        "required": [
          "operator"
        ],
        "title": "SessionResponse",
        "type": "object"
      },
      "StartProposalRequest": {
        "additionalProperties": false,
        "properties": {
          "candidate_artifact_id": {
            "format": "uuid",
            "title": "Candidate Artifact Id",
            "type": "string"
          },
          "command_key": {
            "format": "uuid",
            "title": "Command Key",
            "type": "string"
          }
        },
        "required": [
          "command_key",
          "candidate_artifact_id"
        ],
        "title": "StartProposalRequest",
        "type": "object"
      },
      "StartReturnRefinementRequest": {
        "additionalProperties": false,
        "properties": {
          "command_key": {
            "format": "uuid",
            "title": "Command Key",
            "type": "string"
          },
          "feedback": {
            "$ref": "#/components/schemas/ReturnFeedbackInput"
          },
          "verdict_id": {
            "format": "uuid",
            "title": "Verdict Id",
            "type": "string"
          }
        },
        "required": [
          "verdict_id",
          "feedback",
          "command_key"
        ],
        "title": "StartReturnRefinementRequest",
        "type": "object"
      },
      "SystemStatus": {
        "properties": {
          "counts": {
            "additionalProperties": {
              "type": "integer"
            },
            "propertyNames": {
              "enum": [
                "queued",
                "running",
                "completed",
                "blocked"
              ]
            },
            "title": "Counts",
            "type": "object"
          },
          "health": {
            "additionalProperties": {
              "const": "ok",
              "type": "string"
            },
            "title": "Health",
            "type": "object"
          },
          "readiness": {
            "additionalProperties": {
              "enum": [
                "ready",
                "not_ready"
              ],
              "type": "string"
            },
            "title": "Readiness",
            "type": "object"
          }
        },
        "required": [
          "health",
          "readiness",
          "counts"
        ],
        "title": "SystemStatus",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Alon AI API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/auth/login": {
      "post": {
        "operationId": "login_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Login"
      }
    },
    "/auth/logout": {
      "post": {
        "operationId": "logout_auth_logout_post",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        },
        "summary": "Logout"
      }
    },
    "/auth/session": {
      "get": {
        "operationId": "session_auth_session_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Session"
      }
    },
    "/health/live": {
      "get": {
        "operationId": "live_health_live_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LivenessResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Live"
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "ready_health_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessUnavailableResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Ready"
      }
    },
    "/operator/activity": {
      "get": {
        "operationId": "activity_operator_activity_get",
        "parameters": [
          {
            "in": "query",
            "name": "experiment_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "uuid",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Experiment Id"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActivityResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Activity"
      }
    },
    "/operator/activity/events": {
      "get": {
        "operationId": "activity_events_operator_activity_events_get",
        "parameters": [
          {
            "in": "query",
            "name": "experiment_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "uuid",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Experiment Id"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Activity Events"
